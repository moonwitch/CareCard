# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Prisma / database. SQLite for local dev; swap for a Postgres URL in production.
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-random-secret"

# Anthropic Claude API key — used only server-side. Get one at console.anthropic.com
ANTHROPIC_API_KEY="sk-ant-..."

# Optional: override the model used to generate appointment documents.
# Defaults to claude-sonnet-5. For highest quality use claude-opus-4-8.
ANTHROPIC_MODEL="claude-sonnet-5"
