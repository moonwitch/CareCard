# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- Database ----
# Local dev uses a SQLite file:
DATABASE_URL="file:./dev.db"

# Production uses Turso (hosted libSQL). When TURSO_DATABASE_URL is set, the app
# talks to Turso via the libSQL driver adapter instead of the local file.
# Create a database with the Turso CLI: `turso db create carecard`
# TURSO_DATABASE_URL="libsql://your-db-name.turso.io"
# TURSO_AUTH_TOKEN="your-turso-auth-token"

# (Alternative free host) To use Supabase/Postgres instead of Turso, set the
# datasource provider to "postgresql" in prisma/schema.prisma, remove the libSQL
# adapter in src/lib/prisma.ts, and point DATABASE_URL at your Supabase string.

# ---- Auth ----
# Auth.js secret — generate with: bunx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-random-secret"

# ---- Claude (bring your own key) ----
# CareCard is bring-your-own-key: each user supplies their own Anthropic API key
# in the app, and it is stored only in their browser. The server does NOT need an
# Anthropic key. You may optionally override the model used:
ANTHROPIC_MODEL="claude-sonnet-5"
